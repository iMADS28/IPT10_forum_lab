<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{discussion.title}} — Nested Forum</title>
  <link rel="stylesheet" href="/forum/css/style.css">
</head>
<body>
{{> nav}}

<main class="container">
  <article class="card">
    <h1 class="card-title">{{discussion.title}}</h1>
    <div class="card-meta">
      Posted by <strong>{{discussion.username}}</strong> on <time>{{discussion.created_at}}</time>
    </div>
    <div class="card-body">
      {{discussion.body}}
    </div>
  </article>

  <section>
    <h2 style="font-size: 1.3rem; margin: 24px 0 12px 0;">Comments &amp; Replies</h2>
    {{{tree_html}}}
  </section>

  {{#logged_in}}
    <section class="reply-box">
      <h3>Leave a Reply</h3>
      <form method="POST" action="/forum/discussions/{{discussion_id}}/comments">
        <input type="hidden" name="csrf_token" value="{{csrf_token}}">

        <div style="margin-bottom: 14px;">
          <label for="parent_id">Replying to:</label>
          <select name="parent_id" id="parent_id">
            <option value="">— Top-level comment (Depth 0) —</option>
            {{#comments}}
              <option value="{{id}}">{{label}}</option>
            {{/comments}}
          </select>
        </div>

        <div style="margin-bottom: 14px;">
          <label for="body">Your comment:</label>
          <textarea name="body" id="body" rows="4" required placeholder="Write your message here..."></textarea>
        </div>

        <button type="submit">Post Reply</button>
      </form>
    </section>
  {{/logged_in}}
  {{^logged_in}}
    <div class="notice-box">
      <a href="/forum/login">Log in</a> or <a href="/forum/register">register an account</a> to join the discussion and post a reply.
    </div>
  {{/logged_in}}
</main>

</body>
</html>
