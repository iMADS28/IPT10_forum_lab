<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register — Nested Forum</title>
  <link rel="stylesheet" href="/forum/css/style.css">
</head>
<body>
{{> nav}}

<main class="container" style="max-width: 480px;">
  <div class="card" style="margin-top: 30px;">
    <h1 style="margin-top: 0; font-size: 1.4rem;">Create an Account</h1>

    {{#error}}
      <div class="alert-error">{{error}}</div>
    {{/error}}

    <form method="POST" action="/forum/register">
      <input type="hidden" name="csrf_token" value="{{csrf_token}}">

      <div style="margin-bottom: 14px;">
        <label for="username">Username:</label>
        <input type="text" name="username" id="username" required minlength="2" maxlength="50" placeholder="e.g. johndoe">
      </div>

      <div style="margin-bottom: 14px;">
        <label for="email">Email address:</label>
        <input type="email" name="email" id="email" required maxlength="190" placeholder="e.g. john@example.com">
      </div>

      <div style="margin-bottom: 18px;">
        <label for="password">Password (min 8 characters):</label>
        <input type="password" name="password" id="password" required minlength="8" placeholder="••••••••">
      </div>

      <button type="submit" style="width: 100%;">Register</button>
    </form>

    <p style="margin-bottom: 0; margin-top: 16px; font-size: 0.9rem; text-align: center; color: var(--text-muted);">
      Already have an account? <a href="/forum/login">Log in</a>
    </p>
  </div>
</main>

</body>
</html>
